# ─────────────────────────────────────────────────────────────
# Kingdom environment template
# Copy to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ─── Core ───
KINGDOM_ROOT=/home/techcorp2024/kingdom
APP_ENV=development          # development | production
LOG_LEVEL=info               # debug | info | warning | error

# ─── PostgreSQL (control-plane data) ───
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kingdom
POSTGRES_USER=kingdom
POSTGRES_PASSWORD=change_me
# SQLAlchemy 2.x + psycopg 3 connection URL.
# Keep credentials in sync with the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://kingdom:change_me@localhost:5432/kingdom

# ─── Kingdom API (Flask) ───
API_HOST=127.0.0.1
API_PORT=8000
# Generate a long random value, e.g.:  python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change_me_to_a_long_random_value

# ─── MCP server (stdio transport, localhost only) ───
MCP_HOST=127.0.0.1
MCP_PORT=8765

# ─── Worker / queue (optional — only if the Redis-backed worker is enabled) ───
REDIS_URL=redis://localhost:6379/0
WORKER_CONCURRENCY=2

# ─── Artifact storage ───
ARTIFACTS_DIR=/home/techcorp2024/kingdom/artifacts
