# ─────────────────────────────────────────────────────────────
# Kingdom environment template
# Copy to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ─── Core ───
KINGDOM_ROOT=/home/techcorp2024/kingdom
APP_ENV=development          # development | production
LOG_LEVEL=info               # debug | info | warning | error

# ─── PostgreSQL (control-plane data) ───
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kingdom
POSTGRES_USER=kingdom
# Set a strong value before first boot, e.g.:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change_me
# SQLAlchemy 2.x async URL — asyncpg driver (matches src/kingdom/config.py default).
# Keep credentials in sync with the POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://kingdom:change_me@localhost:5432/kingdom

# ─── Kingdom API (FastAPI / uvicorn) ───
API_HOST=127.0.0.1
API_PORT=8000

# ─── MCP server (stdio transport, localhost only) ───
MCP_HOST=127.0.0.1
MCP_PORT=8765

# ─── Worker / queue (optional — only if the Redis-backed worker is enabled) ───
REDIS_URL=redis://localhost:6379/0
WORKER_CONCURRENCY=2

# ─── Artifact storage ───
ARTIFACTS_DIR=/home/techcorp2024/kingdom/artifacts
